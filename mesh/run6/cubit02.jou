# ----------------------------------------------------------------------
# Create tet4 mesh with resolution dictated by 'cell_size_fn'.
# ----------------------------------------------------------------------
volume all scheme tetmesh
import sizing function "temp_mesh.exo" block all variable "cell_size_fn" time 0
surface 1 sizing function type exodus
surface 2 size {maxCellSize}
surface 3 sizing function type exodus
surface 4 sizing function type exodus
surface 5 sizing function type exodus
surface 6 sizing function type exodus
surface 7 size {maxCellSize}
surface 8 size {maxCellSize}
surface 9 size {maxCellSize}
