# ----------------------------------------------------------------------
# Magma chamber at a 20 km depth in a cyllinder slice
# of viscoelastic material, in a layered
# ----------------------------------------------------------------------
reset
undo off
cd "/home/grantblock/Research/SMBPylith/SMB/Mesh"
# ----------------------------------------------------------------------
# Set units to SI
# ----------------------------------------------------------------------
${Units('si')}
# ----------------------------------------------------------------------
# Set SMB geometry parameters
# ----------------------------------------------------------------------
${SMBdepth=20.0*km}
# Choose radius of a sphere such that the total arc length across the
# magma chamber is 50 km ("major length" = 25 km) and the 
# "minor height" is 100 m (thin)
# a = 2 sqrt[ h (2*R - h) ]
# a = chord length (full distance across magma body :: to be set)
# h = half-height of magma body (from top of body to center :: to be set)
# R = radius of circle/sphere :: to be solved for
${minorLength=0.5*km}
${majorLength=25.0*km}
${sphereRad=625.25*km} #for chamber rad of 25 km
# Domain size parameters
${sizeX=300.0*km}
${sizeY=300.0*km}
${sizeZ=200.0*km}
#${cylinderRadius=100.0*km}
${cylinderRadius=50.0*km}
${cylinderTopHeight=-7.0*km}
${cylinderBottomHeight=-21.0*km}
# for thick upper crust mesh
#${upperCrustHeight=15*km}
#${lowerCrustHeight=15*km}
# For normal mesh
${upperCrustHeight=10*km}
${lowerCrustHeight=20*km}
${lithosphericMantleHeight=70*km}
${asthenosphereHeight=100*km}
#------------------------------------------------------------------------
# Create magma chamber
#------------------------------------------------------------------------
create sphere radius {sphereRad}
# Subtract a brick from the sphere 
brick x {2*sphereRad} y {2*sphereRad} z {2*sphereRad}
move volume 2 x 0 y 0 z {-minorLength}
subtract volume 2 from volume 1
move volume 1 x 0 y 0 z {-sphereRad+minorLength}
# Create open shell
surface 9 copy
delete volume 1
# Copy and reflect, then create a new volume
surface 10 copy reflect z
create volume surface 10 11 heal
compress all
# Move to the SMB depth
volume 1 move x 0 y 0 z {-SMBdepth}
#--------------------------------------------------------------------------
# Create the domain, a block with a cyllinder in it
# Slice the cylinder and get rid of the extra volumes
#--------------------------------------------------------------------------
create cylinder z {sizeZ} radius {cylinderRadius}
volume 2 move x 0 y 0 z {-0.5*sizeZ}
webcut volume 2 with plane zplane offset {cylinderTopHeight}
delete volume 2
webcut volume 3 with plane zplane offset {cylinderBottomHeight}
delete volume 4
compress all
imprint all
merge all
create brick x {sizeX} y {sizeY} z {sizeZ}
volume 3 move x 0 y 0 z {-0.5*sizeZ}
subtract volume 2 from 3
create cylinder z {sizeZ} radius {cylinderRadius}
volume 5 move x 0 y 0 z {-0.5*sizeZ}
webcut volume 5 with plane zplane offset {cylinderTopHeight}
delete volume 5
webcut volume 6 with plane zplane offset {cylinderBottomHeight}
delete volume 7
compress all
imprint all
merge all
#----------------------------------------------------------------------------------------------
# Cut the domain into layers
#----------------------------------------------------------------------------------------------
webcut volume 2 with plane zplane offset {-upperCrustHeight}
webcut volume 4 with plane zplane offset {-upperCrustHeight-lowerCrustHeight}
webcut volume 5 with plane zplane offset {-upperCrustHeight-lowerCrustHeight-lithosphericMantleHeight}
compress all
imprint all
merge all
#------------------------------------------------------------------------------
# Subtract the volumes to make the chamber hollow
#------------------------------------------------------------------------------
subtract body 1 from body 3
imprint all
merge all
compress all
#---------------------------------------------------------------------------
# Set element sizes and mesh the geometry
#---------------------------------------------------------------------------
${maxCellSize=20.0*km}
volume all size {maxCellSize}
volume all scheme tetmesh
mesh surface all
mesh volume all
#Export temp exodus file
set large exodus file off
block 1 volume all
export mesh "temp_mesh.exo" dimension 3 overwrite
#---------------------------------------------------------------------------
# Set element sizes and mesh the geometry
#---------------------------------------------------------------------------
${maxCellSize=20.0*km}
volume all size {maxCellSize}
volume all scheme tetmesh
mesh surface all
mesh volume all
#Export temp exodus file
set large exodus file off
block 1 volume all
export mesh "temp_mesh.exo" dimension 3 overwrite
# ----------------------------------------------------------------------
# Generate geometry
# ----------------------------------------------------------------------
#define cell sizes
${maxCellSize=20.0*km}
${minCellSize=1.0*km}
