# CUBIT journal file for creating blocks and nodesets associated with
# materials and boundary conditions.
# ----------------------------------------------------------------------
# Create blocks for materials
# ----------------------------------------------------------------------
block 1 domain
block  ( at 10000 -10000 0 ordinal 1 ordered )  name "crust"
block 2 reservoir
block  ( at 10000 -16166.7 0 ordinal 1 ordered )  name "reservoir"
# ----------------------------------------------------------------------
# Create nodeset for boundaries
# ----------------------------------------------------------------------
group "boundary_xneg" add node in curve  ( at 0 -10000 0 ordinal 1 ordered ) 
nodeset 20 boundary_xneg
nodeset  ( at 0 -10000 0 ordinal 1 ordered )  name "boundary_xneg"
group "boundary_xpos" add node in curve  ( at 20000 -10000 0 ordinal 1 ordered ) 
nodeset 21 boundary_xpos
nodeset  ( at 20000 -10000 0 ordinal 1 ordered )  name "boundary_xpos"
group "boundary_yneg" add node in curve  ( at 10000 -20000 0 ordinal 1 at 15250 -20000 0 ordinal 1 at 4750 -20000 0 ordinal 1 ordered ) 
nodeset 22 boundary_yneg
nodeset  ( at 10000 -20000 0 ordinal 1 ordered )  name "boundary_yneg"
group "boundary_ypos" add node in curve  ( at 10000 0 0 ordinal 1 ordered ) 
nodeset 23 boundary_ypos
nodeset  ( at 10000 0 0 ordinal 1 ordered )  name "boundary_ypos"
group "boundary_flow" add node in inflow
nodeset 24 boundary_flow
nodeset  ( at 10000 -20000 0 ordinal 2 ordered )  name "boundary_flow"
