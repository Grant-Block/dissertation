create surface rectangle width {length} height {depth} zplane
surface {Id("surface")}  move x {length/2} y {depth/-2} z 0
surface {Id("surface")}  name "domain"
# reservoir
create surface ellipse major radius {major} minor radius {minor} on domain
surface {Id("surface")}  move x {length/2} y {-depth*(2/3)} z 0
surface {Id("surface")}  name "mirror_reservoir"
# Conduit
create surface rectangle width {c_length} height {c_depth} on domain
surface {Id("surface")}  move x {length/2} y {-depth + c_depth/2} z 0
surface {Id("surface")}  name "mirror_conduit"
unite volume  ( at 10000 -13333.3 0 ordinal 1 at 10000 -17000 0 ordinal 1 ordered ) 
imprint all
merge all
delete body  ( at 10000 -16166.7 0 ordinal 1 ordered ) 
#surface 4 rename "reservoir"
surface ( at 10000 -16166.7 0 ordinal 1 ordered ) rename "reservoir"
#surface 5 rename "domain"
surface ( at 10000 -10000 0 ordinal 1 ordered ) rename "domain"
#curve 8 name "inflow"
curve ( at 10000 -20000 0 ordinal 1 ordered ) name "inflow"
#curve 10 name "west_conduit"
curve ( at 9500 -17164.2 0 ordinal 1 ordered ) name "west_conduit"
#curve 11 name "reservoir_interface"
#curve 12 name "east_conduit"
# Cubit journal file with geometry for magma reservoir example.
${Units('si')}
# Clear model
undo off
reset
# Turn on IDless journal files for maximum compatibility.
# The commands echoed to the log will replace the object ID with a
# geometric specification of the object. Note that this means changing
# the geometry will require changes to subsequent journal commands.
# Define variables for geometry.
# Domain
${length = 20*km}
${depth  = 20*km}
${pay = 0.1*km}
# Magma reservoir
${major = 5*km}
${minor  = 1*km}
# Magma conduit
${c_length = 1*km}
${c_depth = 6*km}
# Domain
create surface rectangle width {length} height {depth} zplane
surface {Id("surface")}  move x {length/2} y {depth/-2} z 0
surface {Id("surface")}  name "domain"
# reservoir
create surface ellipse major radius {major} minor radius {minor} on domain
surface {Id("surface")}  move x {length/2} y {-depth*(2/3)} z 0
surface {Id("surface")}  name "mirror_reservoir"
# Conduit
create surface rectangle width {c_length} height {c_depth} on domain
surface {Id("surface")}  move x {length/2} y {-depth + c_depth/2} z 0
surface {Id("surface")}  name "mirror_conduit"
unite volume  ( at 10000 -13333.3 0 ordinal 1 at 10000 -17000 0 ordinal 1 ordered ) 
imprint all
merge all
delete body  ( at 10000 -16166.7 0 ordinal 1 ordered ) 
#surface 4 rename "reservoir"
surface ( at 10000 -16166.7 0 ordinal 1 ordered ) rename "reservoir"
#surface 5 rename "domain"
surface ( at 10000 -10000 0 ordinal 1 ordered ) rename "domain"
#curve 8 name "inflow"
curve ( at 10000 -20000 0 ordinal 1 ordered ) name "inflow"
#curve 10 name "west_conduit"
curve ( at 9500 -17164.2 0 ordinal 1 ordered ) name "west_conduit"
#curve 11 name "reservoir_interface"
#curve 12 name "east_conduit"
# ----------------------------------------------------------------------
# Set discretization size and  scheme
# ----------------------------------------------------------------------
surface all scheme trimesh
surface domain size 1000
surface reservoir size 500
# ----------------------------------------------------------------------
# Generate the mesh
# ----------------------------------------------------------------------
mesh reservoir
mesh domain
# ----------------------------------------------------------------------
# Smooth mesh to improve quality
# ----------------------------------------------------------------------
surface all smooth scheme condition number beta 1.4 cpu 10
smooth surface all
# CUBIT journal file for creating blocks and nodesets associated with
# materials and boundary conditions.
# ----------------------------------------------------------------------
# Create blocks for materials
# ----------------------------------------------------------------------
block 1 domain
block  ( at 10000 -10000 0 ordinal 1 ordered )  name "crust"
block 2 reservoir
block  ( at 10000 -16166.7 0 ordinal 1 ordered )  name "reservoir"
# ----------------------------------------------------------------------
# Create nodeset for boundaries
# ----------------------------------------------------------------------
group "boundary_xneg" add node in curve  ( at 0 -10000 0 ordinal 1 ordered ) 
nodeset 20 boundary_xneg
nodeset  ( at 0 -10000 0 ordinal 1 ordered )  name "boundary_xneg"
group "boundary_xpos" add node in curve  ( at 20000 -10000 0 ordinal 1 ordered ) 
nodeset 21 boundary_xpos
nodeset  ( at 20000 -10000 0 ordinal 1 ordered )  name "boundary_xpos"
group "boundary_yneg" add node in curve  ( at 10000 -20000 0 ordinal 1 at 15250 -20000 0 ordinal 1 at 4750 -20000 0 ordinal 1 ordered ) 
nodeset 22 boundary_yneg
nodeset  ( at 10000 -20000 0 ordinal 1 ordered )  name "boundary_yneg"
group "boundary_ypos" add node in curve  ( at 10000 0 0 ordinal 1 ordered ) 
nodeset 23 boundary_ypos
nodeset  ( at 10000 0 0 ordinal 1 ordered )  name "boundary_ypos"
group "boundary_flow" add node in inflow
nodeset 24 boundary_flow
nodeset  ( at 10000 -20000 0 ordinal 2 ordered )  name "boundary_flow"
